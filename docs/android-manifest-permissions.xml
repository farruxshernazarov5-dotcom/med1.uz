<?xml version="1.0" encoding="utf-8"?>
<!--
  Med1.uz — AndroidManifest.xml uchun ruxsatlar bloki.
  Kompyuteringizda `android/app/src/main/AndroidManifest.xml` faylini oching va
  quyidagi qatorlarni <manifest> tegining ichiga, <application> tegidan OLDIN qo‘ying.
  Keyin: npx cap sync android
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Push-bildirishnomalar (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Aniq vaqtli eslatmalar (dori/qabul reminder) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Qayta yong‘andan keyin eslatmalarni tiklash -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Barmoq izi / Face ID -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Kamera (tahlil/retsept suratga olish) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Mikrofon (ovozli matn kiritish) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

</manifest>
